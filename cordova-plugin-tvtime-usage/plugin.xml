<?xml version="1.0" encoding="UTF-8"?>
<plugin id="cordova-plugin-tvtime-usage" version="1.0.0"
    xmlns="http://apache.org/cordova/ns/plugins/1.0">
    <name>TVTime Usage Stats</name>
    <description>Reads Android UsageStatsManager data for TVTime.</description>
    <license>MIT</license>

    <engines>
        <engine name="cordova-android" version=">=10.0.0" />
    </engines>

    <platform name="android">
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
        </config-file>

        <source-file src="src/android/TVTimeUsage.java"
            target-dir="src/com/alfernado/tvtime" />

        <js-module src="www/tvtime-usage.js" name="TVTimeUsage">
            <clobbers target="cordova.plugins.tvtimeUsage" />
        </js-module>
    </platform>
</plugin>
